# Build Stage for Frontend (pinned to amd64 - lightningcss has no arm/v7 musl binary)
FROM --platform=linux/amd64 node:26-alpine AS frontend-builder
WORKDIR /app/client
# Install pnpm
RUN npm install -g pnpm@10.23.0
# pnpm-workspace.yaml holds allowBuilds/overrides/auditConfig; without it pnpm
# sees no settings and --frozen-lockfile rejects the lockfile.
COPY client/package.json client/pnpm-lock.yaml client/pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile
COPY client/ ./
RUN pnpm build

# Build Stage for Backend
# Cross-compile natively instead of building under QEMU emulation.
FROM --platform=$BUILDPLATFORM golang:1.27.4-alpine3.24 AS backend-builder
ARG TARGETOS TARGETARCH
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Copy compiled frontend from the previous stage
COPY --from=frontend-builder /app/client/dist ./client/dist
ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -ldflags="-s -w -X main.version=${VERSION}" -o goaway .

# Final Stage
FROM alpine:3.24
RUN apk update && apk upgrade && \
    apk add --no-cache ca-certificates curl libcap && \
    adduser -D -u 1000 goaway && \
    mkdir -p /app/config /app/data
WORKDIR /app
COPY --from=backend-builder --chown=goaway:goaway /app/goaway .
# Bind 53/67/547 and send ICMPv6 RAs without running as root.
# Note: HA VIP mode shells out to `ip addr add` and still needs root.
# chown must come first: changing ownership clears the capability xattr.
RUN chown -R goaway:goaway /app && \
    setcap 'cap_net_bind_service=+ep cap_net_raw=+ep' ./goaway
USER goaway

EXPOSE 53/tcp 53/udp 5354/tcp 5354/udp 8080/tcp 67/udp 547/udp
ENTRYPOINT ["./goaway"]
