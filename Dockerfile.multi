# Build Stage for Frontend (pinned to amd64 - lightningcss has no arm/v7 musl binary)
FROM --platform=linux/amd64 node:22-alpine AS frontend-builder
WORKDIR /app/client
# Install pnpm
RUN npm install -g pnpm
COPY client/package.json client/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY client/ ./
RUN pnpm build

# Build Stage for Backend
FROM golang:1.26.5-alpine3.23 AS backend-builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# Copy compiled frontend from the previous stage
COPY --from=frontend-builder /app/client/dist ./client/dist
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o goaway .

# Final Stage
FROM alpine:3.23
RUN apk update && apk upgrade && \
    apk add --no-cache ca-certificates curl libcap && \
    adduser -D -u 1000 goaway && \
    mkdir -p /app/config /app/data
WORKDIR /app
COPY --from=backend-builder --chown=goaway:goaway /app/goaway .
# Bind 53/67/547 and send ICMPv6 RAs without running as root.
# Note: HA VIP mode shells out to `ip addr add` and still needs root.
RUN setcap 'cap_net_bind_service=+ep cap_net_raw=+ep' ./goaway && \
    chown -R goaway:goaway /app
USER goaway

EXPOSE 53/tcp 53/udp 5354/tcp 5354/udp 8080/tcp 67/udp 547/udp
ENTRYPOINT ["./goaway"]
