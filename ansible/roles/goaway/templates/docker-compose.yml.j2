services:
  goaway:
    image: "{{ image_repo }}:{{ image_version }}"
    container_name: goaway
    restart: unless-stopped
    volumes:
      - ./config:/app/config
      - ./data:/app/data
    environment:
      - DNS_PORT={{ dns_port }}
      - WEBSITE_PORT={{ website_port }}
      - PROXY_PORT={{ proxy_port }}
    ports:
      - "{{ dns_port }}:{{ dns_port }}/udp"
      - "{{ dns_port }}:{{ dns_port }}/tcp"
      - "{{ proxy_port }}:{{ proxy_port }}/udp"
      - "{{ proxy_port }}:{{ proxy_port }}/tcp"
      - "{{ website_port }}:{{ website_port }}/tcp"
      - "67:67/udp"
      - "547:547/udp"
    cap_add:
      - NET_BIND_SERVICE
      - NET_RAW
      - NET_ADMIN
    # network_mode: host # Uncomment if high-performance DHCP is needed
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:{{ website_port }}/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 20s
