{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping GoAway /metrics",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "bargauge", "name": "Bar gauge", "version": "" },
    { "type": "panel", "id": "piechart", "name": "Pie chart", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Official GoAway DNS observability dashboard: QPS, block rate, cache/stale/prefetch, DNSSEC, latency percentiles, and upstream wins.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "DNS QPS",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] } },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(goaway_dns_queries_total{instance=~\"$instance\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Block Rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 5, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 0.4 }, { "color": "red", "value": 0.7 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(goaway_dns_blocked_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(goaway_dns_queries_total{instance=~\"$instance\"}[$__rate_interval])), 1e-9)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Cache Hit Ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 10, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "orange", "value": null }, { "color": "green", "value": 0.3 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(goaway_dns_cached_total{instance=~\"$instance\"}[$__rate_interval])) / clamp_min(sum(rate(goaway_dns_queries_total{instance=~\"$instance\"}[$__rate_interval])), 1e-9)" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P95 Resolution Latency",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 5, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.2 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le) (rate(goaway_dns_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Healthy Components",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "min(goaway_service_health{instance=~\"$instance\"})" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DNS Query Breakdown (QPS)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "Total", "expr": "sum(rate(goaway_dns_queries_total{instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "Cached", "expr": "sum(rate(goaway_dns_cached_total{instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "C", "legendFormat": "Forwarded", "expr": "sum(rate(goaway_dns_forwarded_total{instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "D", "legendFormat": "Blocked", "expr": "sum(rate(goaway_dns_blocked_total{instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "E", "legendFormat": "Throttled", "expr": "sum(rate(goaway_dns_throttled_total{instance=~\"$instance\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DNS Queries by Record Type",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{type}}", "expr": "sum by (type) (rate(goaway_dns_queries_total{instance=~\"$instance\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Resolution Latency Percentiles (P50 / P95 / P99)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "P50", "expr": "histogram_quantile(0.50, sum by (le) (rate(goaway_dns_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))" },
        { "refId": "B", "legendFormat": "P95", "expr": "histogram_quantile(0.95, sum by (le) (rate(goaway_dns_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))" },
        { "refId": "C", "legendFormat": "P99", "expr": "histogram_quantile(0.99, sum by (le) (rate(goaway_dns_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Cache Efficiency (Cached, Serve-Stale, Prefetch Hits)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "Cached", "expr": "sum(rate(goaway_dns_cached_total{instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "Serve-Stale", "expr": "sum(rate(goaway_dns_stale_total{instance=~\"$instance\"}[$__rate_interval]))" },
        { "refId": "C", "legendFormat": "Prefetch Hits", "expr": "sum(rate(goaway_dns_prefetch_hit_total{instance=~\"$instance\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Upstream Wins by Server & Protocol",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{upstream}} ({{protocol}} / {{strategy}})", "expr": "sum by (upstream, protocol, strategy) (rate(goaway_dns_upstream_wins_total{instance=~\"$instance\"}[$__rate_interval]))" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Upstream P95 Latency by Server & Protocol",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{upstream}} ({{protocol}})", "expr": "histogram_quantile(0.95, sum by (le, upstream, protocol) (rate(goaway_dns_upstream_latency_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))" }
      ]
    },
    {
      "id": 12,
      "type": "bargauge",
      "title": "Top 10 Blocked Domains",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{domain}}", "expr": "topk(10, sum by (domain) (increase(goaway_dns_blocked_total{instance=~\"$instance\"}[$__range])))" }
      ]
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Blocked by Category",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{category}}", "expr": "sum by (category) (increase(goaway_dns_categories_blocked_total{instance=~\"$instance\"}[$__range]))" }
      ]
    },
    {
      "id": 14,
      "type": "piechart",
      "title": "DNSSEC Validation Status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "legendFormat": "{{dnssec_status}}", "expr": "sum by (dnssec_status) (increase(goaway_dns_dnssec_total{instance=~\"$instance\"}[$__range]))" }
      ]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["goaway", "dns", "prometheus"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(goaway_dns_queries_total, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "GoAway DNS Overview",
  "uid": "goaway-dns-overview",
  "version": 1
}
